# Walplay backend environment inventory.
# Copy to .env.local for local development. Never commit .env.local.
# Secrets are server-side only and must never be exposed through VITE_* variables.

# Optional. development | test | production. Default: development
NODE_ENV=development

# Optional. HTTP listen port. Default: 4000
PORT=4000

# Required in production; defaults to the local frontend in development.
# Comma-separated exact origins, no wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required. Server-side TMDB bearer access token. Never commit a real value.
TMDB_ACCESS_TOKEN=

# Optional provider configuration.
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_TIMEOUT_MS=5000
TMDB_MAX_RETRIES=2
TMDB_CACHE_TTL_SECONDS=300
TMDB_CACHE_STALE_SECONDS=86400
TMDB_CACHE_MAX_ENTRIES=500
TMDB_IMAGE_CONFIG_TTL_SECONDS=86400

# Optional. debug | info | warn | error. Default: info
LOG_LEVEL=info

# Optional streaming availability capability (release-gated). Default: false
AVAILABILITY_ENABLED=false
AVAILABILITY_LOGOS_ENABLED=false
AVAILABILITY_SUPPORTED_REGIONS=CO
AVAILABILITY_CACHE_TTL_SECONDS=21600
AVAILABILITY_CACHE_STALE_SECONDS=604800
AVAILABILITY_CACHE_MAX_ENTRIES=500
AVAILABILITY_FRESHNESS_WINDOW_SECONDS=86400
AVAILABILITY_DESTINATION_HOSTS=www.themoviedb.org,themoviedb.org
