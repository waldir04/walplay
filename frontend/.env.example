# Required. One of: local | development | staging | production
VITE_APP_ENV=local

# Optional. Defaults to 0.0.0 when absent. Never shown in the interface.
VITE_APP_VERSION=0.0.0

# Required in production. Local default: http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# Optional streaming availability capability. Default: false
# Enable together with the backend AVAILABILITY_ENABLED flag.
VITE_AVAILABILITY_ENABLED=false

# Optional promotional trailers capability. Default: false
# Enable together with the backend TRAILERS_ENABLED flag.
VITE_TRAILERS_ENABLED=false

# Optional recommendations capability. Default: false
# Validated optional flag. Enable only when the product and documentation
# release gates recorded for the recommendation area are complete.
VITE_RECOMMENDATIONS_ENABLED=false
